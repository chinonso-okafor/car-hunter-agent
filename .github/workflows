name: Car Hunter Agent

on:
  schedule:
    # Run every 2 hours
    - cron: '0 */2 * * *'
  workflow_dispatch: # Allow manual trigger

jobs:
  scan:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v3
        with:
          fetch-depth: 0
      
      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '18'
      
      - name: Install dependencies
        run: npm install
      
      - name: Run Car Hunter Agent
        env:
          GMAIL_USER: ${{ secrets.GMAIL_USER }}
          GMAIL_APP_PASSWORD: ${{ secrets.GMAIL_APP_PASSWORD }}
          ALERT_EMAIL: ${{ secrets.ALERT_EMAIL }}
        run: node car-hunter-agent.js
      
      - name: Commit and push seen listings
        run: |
          git config --local user.email "action@github.com"
          git config --local user.name "Car Hunter Bot"
          git add seen_listings.json 2>/dev/null || true
          git diff --quiet && git diff --staged --quiet || git commit -m "Update seen listings at $(date -u +'%Y-%m-%dT%H:%M:%SZ')"
          git push origin main || true
